# Provider keys are not read from the environment: add them in the app's Providers panel.
# Optional
# XAI_REALTIME_URL=wss://api.x.ai/v1/realtime?model=grok-voice-latest
# OSMO_VOICE=eve
# OSMO_STATIC_DIR=../web/dist
# Subscription sign-in (Grok, ChatGPT, Claude) runs background agents on your plan; voice still needs an API key.
# OSMO_AGENT_MODEL=grok:grok-4.20-0309-reasoning
# Set to 0 when the server is not on your machine: the ChatGPT sign-in then asks you to paste the redirect URL.
# OSMO_SUBSCRIPTION_LOOPBACK=1
