# Provider keys are not read from the environment: add them in the app's Providers panel.
# Optional
# XAI_REALTIME_URL=wss://api.x.ai/v1/realtime?model=grok-voice-latest
# OSMO_VOICE=eve
# OSMO_STATIC_DIR=../web/dist
# Subscription sign-in (Grok, ChatGPT, Claude) runs background agents on your plan; voice still needs an API key.
# OSMO_AGENT_MODEL=grok:grok-4.7
# The API answers only to 127.0.0.1, localhost and ::1 (a DNS-rebinding page is refused); add other host names you
# reach it by, comma-separated. Requests from any other origin (another port included) and non-JSON writes are refused too.
# OSMO_ALLOWED_HOSTS=osmo.lan
# Behind a TLS reverse proxy, run uvicorn with --proxy-headers and FORWARDED_ALLOW_IPS=<the proxy's address>, or the strict Origin check refuses https pages.
# The desktop app makes a secret token per launch and passes it to the server on stdin; then only its windows can use the
# API. A server you run yourself has none (unless you start it and the app with the same OSMO_DESKTOP_TOKEN), so while
# vault_write needs approval the Notes editor cannot save there (use the desktop app, or take vault_write out of
# OSMO_APPROVAL_TOOLS), and the Spotify player's token is not handed out.
# Set to 0 when the server is not on your machine: the ChatGPT sign-in then asks you to paste the redirect URL.
# OSMO_SUBSCRIPTION_LOOPBACK=1
# Markdown note vaults (name=path, comma-separated); unset means notes=~/Osmo/Notes, empty turns notes off.
# OSMO_VAULTS=notes=~/Osmo/Notes,work=~/Documents/Work notes
# The IANA zone the calendar tools read times in (default: the machine's zone).
# OSMO_TIMEZONE=America/Los_Angeles
# The agent browser (OSMO_TOOLS must include browser). Chrome is found on its own; set a path to pick one.
# OSMO_BROWSER_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# 1 keeps logins in Osmo's own profile (~/.config/osmo/browser-profile), or name a folder. Mind that what you sign in
# to after Take over stays signed in for the agent too, in later runs. On a site you took over on, an `allow` rule no
# longer skips approval: the agent's clicks, typing and key presses there ask again.
# OSMO_BROWSER_PROFILE=1
# 1 opens a real browser window as well as the widget.
# OSMO_BROWSER_VISIBLE=1
# Per-site rules: allow (no approval for clicks/typing), ask (always ask), deny (off limits).
# OSMO_BROWSER_RULES=github.com=allow,bank.example=deny
# Music: folders of your own audio files (separated by : or ; on Windows); unset means ~/Music, empty turns local files off.
# OSMO_MUSIC_DIRS=~/Music:~/Downloads/Albums
# Spotify (Premium, desktop app only): the client id of your own Spotify app (PKCE, no secret), and the redirect URI
# registered on it; the default is this server's http://127.0.0.1:<port>/api/music/spotify/callback.
# OSMO_SPOTIFY_CLIENT_ID=
# OSMO_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/music/spotify/callback
# Desktop packaging: skip castLabs VMP signing for a local test build (Widevine may then refuse Spotify).
# OSMO_VMP_SIGN=skip
