# Provider keys are not read from the environment: add them in the app's Providers panel.
# Required: each voice model's context window in tokens. xAI publishes none for its realtime
# models, so choose them; the server refuses to start without one per model.
OSMO_VOICE_CONTEXT_LIMITS=grok:grok-voice-latest=<tokens>,grok:grok-voice-3.0=<tokens>
# Optional
# XAI_REALTIME_URL=wss://api.x.ai/v1/realtime?model=grok-voice-latest
# OSMO_VOICE=eve
# OSMO_STATIC_DIR=../web/dist
